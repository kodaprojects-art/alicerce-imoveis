---
interface Props {
  dir?: 'left' | 'right';
}

const { dir = 'right' } = Astro.props;
---

<svg class="arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" style={dir === 'left' ? 'transform: scaleX(-1)' : undefined}>
  <path d="M2 8h12M9 3l5 5-5 5"></path>
</svg>
